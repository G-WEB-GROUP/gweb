# Copy to /etc/bakedinweston/contact.env (chmod 600, owner root) and fill in.
# SMTP account that is allowed to send mail. With GoDaddy/Microsoft 365 mail this is usually
# smtp.office365.com:587 (STARTTLS) with the mailbox login; with Google Workspace smtp.gmail.com:587
# and an app password. Any transactional provider (Postmark, Mailgun, SES…) also works.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@bakedinweston.com
SMTP_PASS=change-me

MAIL_TO=inna@bakedinweston.com
MAIL_FROM=website@bakedinweston.com
PORT=8787
