---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE } from '../lib/site';
import { photo } from '../lib/images';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImageFile?: string;
  jsonLd?: object[];
  preloadImage?: string;
}
const {
  title,
  description,
  ogTitle = SITE.name,
  ogDescription = SITE.ogDescription,
  ogImageFile = 'unnamed-3',
  jsonLd = [],
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(path, SITE.url).href.replace(/\/$/, path === '/' ? '/' : '');

const ogSrc = photo(ogImageFile);
const og = ogSrc ? await getImage({ src: ogSrc, width: 1200, format: 'jpg', quality: 80 }) : undefined;
const ogUrl = og ? new URL(og.src, SITE.url).href : undefined;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content="Weston Bakery: Fresh Sourdough Breads and Baked Goods" />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}
    <meta name="twitter:image:alt" content={SITE.name} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
