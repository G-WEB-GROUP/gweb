---
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import home from '../../../content/home.json';
import { STOREFRONT } from '../../lib/site';
const { difference, marquee } = home;
const products = ['White', 'Country', 'Whole Wheat', 'Rye', 'Bagels', 'Vegan Scones'];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {Array.from({ length: 6 }).map(() => <span>{marquee}</span>)}
  </div>
</div>
<p class="visually-hidden">{marquee}</p>

<section class="section diff" aria-labelledby="diff-title">
  <div class="wrap diff-grid">
    <Photo
      file={difference.image.file}
      alt={difference.image.alt}
      widths={[400, 640, 960, 1200]}
      sizes="(min-width: 900px) 44vw, 92vw"
      ratio="4 / 3"
      class="diff-img"
    />
    <div>
      <p class="eyebrow">Handcrafted in small batches</p>
      <h2 id="diff-title">{difference.title}</h2>
      <p class="lead">{difference.text}</p>
      <ul class="chips" aria-label="What I bake">
        {products.map((p) => <li>{p}</li>)}
      </ul>
      <a class="more" href="/all-products">See all products <Icon name="arrow" /></a>
      <span class="sep" aria-hidden="true">·</span>
      <a class="more" href={STOREFRONT.menu}>View my menu <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .marquee {
    background: var(--accent);
    color: var(--ink);
    overflow: hidden;
    white-space: nowrap;
    padding-block: 14px;
    font: italic 500 clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem) / 1 var(--font-serif);
  }
  .marquee-track {
    display: inline-flex;
    gap: 3rem;
    animation: slide 40s linear infinite;
  }
  .marquee-track span::after {
    content: '✻';
    margin-left: 3rem;
    font-style: normal;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
  .diff-grid {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .diff-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .diff-grid :global(.diff-img) {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--crust);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    min-height: 44px;
  }
  .more :global(svg) {
    width: 18px;
    height: 18px;
  }
  .sep {
    margin-inline: 10px;
    color: var(--muted);
  }
</style>
