---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import faq from '../../content/faq.json';
import seo from '../../content/seo.json';
import { STOREFRONT, CONTACT } from '../lib/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((i) => ({
    '@type': 'Question',
    name: i.question,
    acceptedAnswer: { '@type': 'Answer', text: i.answer },
  })),
};
---

<Base title={seo.faq.title} description={seo.faq.description!} jsonLd={[faqLd]}>
  <PageHead title={faq.h1} eyebrow="Questions & answers" />

  <section class="wrap faq" aria-label="Frequently asked questions">
    <div class="list">
      {
        faq.items.map((item, i) => (
          <details class="qa" open={i === 0}>
            <summary>
              <span class="q">{item.question}</span>
              <span class="pm" aria-hidden="true" />
            </summary>
            <div class="a">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>

    <aside class="help">
      <h2>Still have a question?</h2>
      <p>Call, text on WhatsApp or write — I'm happy to help.</p>
      <ul>
        <li><a href={CONTACT.phoneHref}><Icon name="phone" /> {CONTACT.phoneDisplay}</a></li>
        <li><a href={CONTACT.whatsapp} rel="noopener"><Icon name="chat" /> WhatsApp</a></li>
        <li><a href="/#contact"><Icon name="mail" /> Contact form</a></li>
      </ul>
      <a class="btn btn--primary" href={STOREFRONT.menu}><Icon name="bag" /> {faq.cta.text}</a>
    </aside>
  </section>
</Base>

<style>
  .faq {
    display: grid;
    gap: 40px;
    padding-block: clamp(32px, 5vw, 64px) clamp(56px, 8vw, 96px);
  }
  @media (min-width: 1000px) {
    .faq {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 64px;
      align-items: start;
    }
    .help {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .list {
    display: grid;
    gap: 12px;
  }
  .qa {
    background: var(--white);
    border: 1px solid var(--crust);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }
  .qa[open] {
    border-color: var(--accent);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary .q {
    font: 600 clamp(1.1rem, 1rem + 0.4vw, 1.3rem) / 1.3 var(--font-serif);
    color: var(--ink);
  }
  .pm {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-soft);
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 14px;
    height: 2px;
    background: var(--accent-ink);
    translate: -50% -50%;
    transition: rotate 0.2s;
  }
  .pm::after {
    rotate: 90deg;
  }
  .qa[open] .pm::after {
    rotate: 0deg;
  }
  .a {
    padding: 0 22px 8px;
    max-width: 70ch;
  }
  .help {
    background: var(--ink);
    color: #efe2d2;
    border-radius: var(--radius);
    padding: 26px;
  }
  .help h2 {
    color: var(--white);
    font-size: 1.5rem;
  }
  .help ul {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    line-height: 2.4;
  }
  .help a:not(.btn) {
    color: #efe2d2;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .help a:not(.btn):hover {
    color: var(--accent);
  }
  .help :global(svg) {
    width: 20px;
    height: 20px;
  }
  .help :focus-visible {
    outline-color: var(--accent);
  }
</style>
